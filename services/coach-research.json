{
  "service": "bep-coach-web-research",
  "version": 1,
  "enabled": true,
  "runtime_default_enabled": false,
  "provider": "gemini-google-search-grounding",
  "default_model": "gemini-2.5-flash",
  "api_key_env": "BEP_AGENT_GEMINI_API_KEY",
  "required_gates": {
    "feature_flag": "BEP_COACH_WEB_RESEARCH_ENABLED=true",
    "dedicated_agent_key": true
  },
  "api": {
    "method": "POST",
    "path": "/api/admin/bep-coach/research",
    "authentication": "bep_session_and_agent_admin",
    "cache": "no-store"
  },
  "provider_reference": {
    "model": "gemini-2.5-flash",
    "free_tier_grounding_rpd_reference": 500,
    "shared_quota": "Gemini 2.5 Flash and Flash-Lite, subject to the Google AI Studio project quota",
    "monthly_estimate_basis_days": 30,
    "monthly_estimate_is_guaranteed": false
  },
  "usage_tracking": {
    "table": "bep_coach_provider_usage",
    "tracked_types": [
      "google_search_grounding",
      "json_library_consultation"
    ],
    "store_prompt_content": false,
    "store_financial_data": false
  },
  "limits": {
    "query_max_length": 500,
    "max_proposals_per_run": 5,
    "max_content_chars": 1800,
    "timeout_ms": 30000
  },
  "research_policy": {
    "language": "fr",
    "categories": [
      "budget",
      "spending",
      "savings",
      "debt",
      "behavior",
      "income",
      "planning",
      "general"
    ],
    "require_grounding_sources": true,
    "require_https_source": true,
    "reject_model_only_sources": true,
    "treat_web_content_as_untrusted": true,
    "automatic_publication": false,
    "human_approval_required": true,
    "destination": "existing_bep_knowledge_candidates",
    "approved_destination": "existing_bep_financial_knowledge"
  },
  "proposal_document": {
    "contract": "services/coach-proposals.json",
    "format": "bep-coach-proposals",
    "endpoint": "/api/admin/bep-coach/proposals.json",
    "storage_table": "bep_knowledge_candidates",
    "pending_only_by_default": true
  }
}
