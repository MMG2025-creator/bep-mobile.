{
  "service": "bep-coach-library",
  "version": 1,
  "enabled": true,
  "read_only": true,
  "storage": {
    "provider": "postgresql",
    "reuse_existing_database": true,
    "tables": [
      "bep_financial_knowledge",
      "bep_agent_approved_knowledge",
      "bep_user_coach_knowledge",
      "bep_user_data",
      "bep_monthly_budgets",
      "bep_monthly_budget_items"
    ],
    "create_tables": false
  },
  "api": {
    "method": "GET",
    "path": "/api/coach/library",
    "authentication": "bep_session",
    "query_max_length": 4000,
    "result_limit": 8,
    "cache": "no-store"
  },
  "privacy": {
    "user_scope_required": true,
    "financial_context_scope": "authenticated_user_only",
    "never_return_other_users_data": true
  },
  "ranking": {
    "engine": "bep-financial-intelligence",
    "include_approved_global_knowledge": true,
    "include_accepted_user_knowledge": true,
    "pending_knowledge_visible_to_coach": false
  }
}